# Copy this file to .env and replace every example value.
DATABASE_URL=sqlite:///./casino.db
SECRET_KEY=replace-with-a-long-random-secret
APP_ENV=development
FRONTEND_URL=http://127.0.0.1:5500
FRONTEND_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# Public registration requires a working SMTP relay for email verification.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
